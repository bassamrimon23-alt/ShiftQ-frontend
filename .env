# Employee screens talk to the API layer in src/api (Armia's).
# true = Mock APIs, false = real backend (then set VITE_API_BASE_URL).
VITE_USE_MOCK=true
VITE_API_BASE_URL=http://localhost:5000/api

# Mock settings only
VITE_MOCK_LATENCY_MS=400
# false = the mock really checks the geofence: "Use office location (demo)" passes, other places are rejected
VITE_MOCK_ALWAYS_INSIDE=false
VITE_MOCK_STRICT_GPS=false

# 'api' (default) = Armia's API layer, 'local' = standalone mock in src/services/attendanceMock.js
VITE_ATTENDANCE_SOURCE=api
